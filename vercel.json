{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/primary",
      "destination": "/kids",
      "permanent": false
    },
    {
      "source": "/highschool",
      "destination": "/kids",
      "permanent": false
    },
    {
      "source": "/university",
      "destination": "/kids",
      "permanent": false
    },
    {
      "source": "/stage-preview",
      "destination": "/kids",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/kokoro",
      "destination": "https://smartclass-wlgb.onrender.com/api/neo/speak"
    },
    {
      "source": "/kids",
      "destination": "/kids.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "unsafe-none"
        }
      ]
    }
  ]
}
